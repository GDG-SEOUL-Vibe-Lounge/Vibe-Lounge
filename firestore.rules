rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DevFest Seoul 2026 쉬는 시간 프로그램: 키(key)별 문서 1개, 값은 JSON 문자열(v)
    match /dfs26/{key} {
      allow read: if true;
      allow create, update: if key.matches('^[a-z0-9:_-]{1,40}$')
        && request.resource.data.keys().hasOnly(['v', 'at'])
        && request.resource.data.v is string
        && request.resource.data.v.size() < 900000
        && request.resource.data.at is number;
      allow delete: if false;
    }
  }
}
